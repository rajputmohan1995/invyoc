@using invyoc.Controllers
@model List<InvoiceFileEntry>

<h2>Invoice Details</h2>

@foreach (var entry in Model)
{
    <div class="card p-3 mb-3">
        <h4>Invoice Info</h4>
        <p><strong>Invoice Number:</strong> @entry.InvoiceVM.InvoiceNumber</p>
        <p><strong>Date:</strong> @entry.InvoiceVM.InvoiceDate.ToShortDateString()</p>
        <p><strong>Due Date:</strong> @entry.InvoiceVM.DueDate.ToShortDateString()</p>
        <p><strong>Subtotal:</strong> @entry.InvoiceVM.Currency @entry.InvoiceVM.Subtotal</p>
    </div>

    <div class="card p-3 mb-3">
        <h4>Company</h4>
        <p>@entry.InvoiceVM.Company.Name</p>
        <p>GST: @entry.InvoiceVM.Company.GSTNo</p>
        <p>
            @entry.InvoiceVM.Company.CompanyAddress.Address,
            @entry.InvoiceVM.Company.CompanyAddress.City
        </p>
    </div>

    <div class="card p-3 mb-3">
        <h4>Bill To</h4>
        <p>@entry.InvoiceVM.BillTo.Name</p>
        <p>GST: @entry.InvoiceVM.BillTo.GSTNo</p>
    </div>

    <div class="card p-3 mb-3">
        <h4>Items</h4>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Line</th>
                    <th>Description</th>
                    <th>Qty</th>
                    <th>Rate</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in entry.InvoiceVM.Items)
                {
                    <tr>
                        <td>@item.LineNumber</td>
                        <td>@item.Description</td>
                        <td>@item.Quantity</td>
                        <td>@item.Rate</td>
                        <td>@item.Amount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-action="Process"
       asp-route-id="@entry.Id"
       target="_blank"
       class="btn btn-lg btn-success">
        Process
    </a>

    <br />
    <hr />
}
<br />
<a asp-action="Upload" class="btn btn-secondary">Upload Another</a>