@model InvoiceViewModel


<div class="row" id="divBillToAndShipTo">

    <div class="col-sm-6 col-md-6 col-lg-6" id="divBillTo">

        <h5>
            <strong>Bill To</strong>
        </h5>

        <input type="text" class="mb-1 w-100" asp-for="BillTo.Name" placeholder="Your Client's Company" />
        <span asp-validation-for="BillTo.Name" class="text-danger"></span>

        <input type="text" class="mb-1 w-100" asp-for="BillTo.GSTNo" placeholder="Client's GSTIN" />

        <input type="text" class="mb-1 w-100" asp-for="BillTo.Address" placeholder="Client's Address" />

        <input type="text" class="mb-1 w-100" asp-for="BillTo.City" placeholder="City" />

        <input type="text" class="mb-1 w-100" asp-for="BillTo.State" placeholder="State" />

        <input type="text" class="mb-1 w-100" asp-for="BillTo.Country" placeholder="Country" />

        <input type="tel" class="mb-1 w-100" asp-for="BillTo.ContactNum" placeholder="Client's Contact" />

    </div>

    <div class="col-sm-6 col-md-6 col-lg-6" id="divShipTo">
        <h5>
            <strong>Ship To </strong>
            <small>(optional)</small>
        </h5>

        <input type="text" class="mb-1 w-100" asp-for="ShipTo.Address" placeholder="Client's Ship To Address" />

        <input type="text" class="mb-1 w-100" asp-for="ShipTo.City" placeholder="City" />

        <input type="text" class="mb-1 w-100" asp-for="ShipTo.State" placeholder="State" />

        <input type="text" class="mb-1 w-100" asp-for="ShipTo.Country" placeholder="Country" />

        <input type="tel" class="mb-1 w-100" asp-for="ShipTo.ContactNum" placeholder="Client's Ship To Contact" />

    </div>

</div>