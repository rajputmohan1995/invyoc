@model InvoiceViewModel

<style>
    #logoDropZone {
        border: 2px dashed #ccc;
        text-align: center;
        cursor: pointer;
        background-color: #f9f9f9;
        transition: background 0.3s;
        width: 125px;
        height: 125px;
    }

        #logoDropZone:hover {
            border-color: #0dcaf0;
        }

        #logoDropZone p {
            margin-top: 2.5rem;
        }

        #logoDropZone.hover {
            background-color: #e6f7ff;
        }

        #logoDropZone #logoPreview {
            width: 125px;
            height: 125px;
        }

    .upload-section-note-main {
        max-width: 200px;
        padding: 10px 15px;
    }

    .upload-section-note {
        margin: auto;
    }

        .upload-section-note div {
            color: #676767;
            font-size: 10px;
            padding-top: 5px;
        }

    .invoice-main-details input {
        max-width: 150px;
    }
</style>

<div class="row">

    <div class="col-sm-6 col-md-6 col-lg-6" id="divInvoiceFrom">

        <div class="row">

            <div class="col mb-2" style="display:flex;">

                <div id="logoDropZone">
                    <p class="text-info">
                        <i class="fa-2x fa-solid fa-upload mb-1"></i>
                        <br />
                        <strong>Upload</strong>
                    </p>

                    <input type="file" id="logoInput" accept="image/*" hidden />
                    @if (!string.IsNullOrWhiteSpace(Model.Company.LogoBase64))
                    {
                        <img id="logoPreview" src="@Model.Company.LogoBase64" alt="Logo Preview" />
                    }
                    else
                    {
                        <img id="logoPreview" src="" alt="Logo Preview" style="display:none;" />
                    }

                    <input hidden asp-for="Company.LogoBase64" id="companyLogoBase64" />
                </div>

                <div class="text-center upload-section-note-main">
                    <div class="upload-section-note mt-4">
                        Upload Logo
                        <br />
                        <div>
                            Drag & drop company logo here
                            <br />or click to upload
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.Name" type="text" class="w-100" placeholder="Your Company" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.GSTNo" type="text" class="w-100" placeholder="Company's GSTIN" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.Phone" type="tel" class="w-100" placeholder="Company Contact" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.Email" type="email" class="w-100" placeholder="Company Email" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.Address" type="text" class="w-100" placeholder="Company Address" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.City" type="text" class="w-100" placeholder="City" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.State" type="text" class="w-100" placeholder="State" />
            </div>
        </div>

        <div class="row mb-1">
            <div class="col">
                <input asp-for="Company.Country" type="text" class="w-100" placeholder="Country" />
            </div>
        </div>

    </div>

    <div class="col-sm-6 col-md-6 col-lg-6 text-end">

        <h1 style="height:125px;">
            Tax Invoice
        </h1>

        <div class="d-flex align-items-center gap-2 justify-content-end" id="divOtherInvoiceInfo">

            <div class="d-flex flex-column gap-2 invoice-main-details">

                <div class="d-flex align-items-center gap-2 justify-content-end text-end">
                    <label class="form-label mb-0" asp-for="InvoiceNumber">Invoice#</label>
                    <input type="text" class="w-100 fw-bold" asp-for="InvoiceNumber"
                           pattern="[a-zA-Z0-9]*"
                           placeholder="#101" />
                </div>

                <div class="d-flex align-items-center gap-2 justify-content-end text-end">
                    <label class="form-label mb-0" asp-for="InvoiceDate">Date</label>
                    <input type="date" class="w-100" asp-for="InvoiceDate" />
                </div>
                <div class="d-flex align-items-center gap-2 justify-content-end text-end">
                    <label class="form-label mb-0" asp-for="DueDate">Due Date</label>
                    <input type="date" class="w-100" asp-for="DueDate" />
                </div>

                <div class="d-flex align-items-center gap-2 justify-content-end text-end">
                    <label class="form-label mb-0" asp-for="PaymentTerms">Payment Terms</label>
                    <input type="text" class="w-100" placeholder="Payment Terms" asp-for="PaymentTerms" />
                </div>
                <div class="d-flex align-items-center gap-2 justify-content-end text-end">
                    <label class="form-label mb-0" asp-for="PONumber">PO Number</label>
                    <input type="text" class="w-100" placeholder="PO No." asp-for="PONumber" />
                </div>

            </div>

            @*    <h5>
                Invoice#
            </h5>
            <input asp-for="InvoiceNumber" type="text"
                   class="form-control border-0 p-0 mb-1 bg-light"
                   pattern="[a-zA-Z0-9]*"
                   style="font-size: 1.25rem;" oninput="setInvoiceNumWidthAsPerContent()" /> *@
        </div>
    </div>

    <div class="mt-3">
    </div>
</div>