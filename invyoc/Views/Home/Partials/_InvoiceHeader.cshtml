@model InvoiceViewModel

<style>
    #logoDropZone {
        border: 2px dashed #ccc;
        text-align: center;
        cursor: pointer;
        background-color: #f9f9f9;
        transition: background 0.3s;
        width: 150px;
        height: 150px;
    }

        #logoDropZone:hover {
            border-color: #258cfb;
        }

        #logoDropZone p {
            margin-top: 1.5rem;
        }

        #logoDropZone.hover {
            background-color: #e6f7ff;
        }

        #logoDropZone #logoPreview {
            width: 150px;
            height: 150px;
        }
</style>

<div class="row">
    <div class="col-9 px-0" id="divInvoiceFrom">
        <h2>
            <input asp-for="Company.Name"
                   type="text"
                   class="form-control border-0 fs-2 p-0 bg-light"
                   placeholder="Company Name" />
        </h2>
        <div class="row">
            <div class="col-6">
                <input asp-for="Company.GSTNo"
                       type="text"
                       class="form-control form-control-sm border-0 p-0 mb-1 bg-light fw-bold text-uppercase"
                       placeholder="Tax Number" />
            </div>
            <div class="offset-col-6"></div>
        </div>
        <div class="row">
            <div class="col">
                <input asp-for="Company.Address"
                       type="text"
                       class="form-control form-control-sm border-0 p-0 mb-1 bg-light"
                       placeholder="Company Address" />
            </div>
        </div>
        <div class="row">
            <div class="col-3">
                <input asp-for="Company.Phone"
                       type="tel"
                       class="form-control form-control-sm border-0 p-0 bg-light"
                       placeholder="Company Contact" />
            </div>
            <div class="col-4">
                <input asp-for="Company.Email"
                       type="email"
                       class="form-control form-control-sm border-0 p-0 bg-light"
                       placeholder="Company Email" />
            </div>
            <div class="offset-col-6"></div>
        </div>

    </div>

    <div class="col-3 px-0">
        <div class="d-flex align-items-center gap-2 justify-content-end text-end" id="divInvoiceNum">

            <div id="logoDropZone">
                <p>Drag & drop company logo here, or click to upload</p>
                <input type="file" id="logoInput" accept="image/*" hidden />
                @if (!string.IsNullOrWhiteSpace(Model.Company.LogoBase64))
                {
                    <img id="logoPreview" src="@Model.Company.LogoBase64" alt="Logo Preview" />
                }
                else
                {
                    <img id="logoPreview" src="" alt="Logo Preview" style="display:none;" />
                }

                <input hidden asp-for="Company.LogoBase64" id="companyLogoBase64" />
            </div>

            @*    <h5>
                Invoice#
            </h5>
            <input asp-for="InvoiceNumber" type="text"
                   class="form-control border-0 p-0 mb-1 bg-light"
                   pattern="[a-zA-Z0-9]*"
                   style="font-size: 1.25rem;" oninput="setInvoiceNumWidthAsPerContent()" /> *@
        </div>
    </div>

    <hr class="mt-3">

</div>