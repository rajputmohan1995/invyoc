@model InvoiceViewModel

@{
    Model.PaymentNotes = string.IsNullOrWhiteSpace(Model.PaymentNotes)
        ? "It was great doing business with you."
        : Model.PaymentNotes;

    Model.PaymentTerms = string.IsNullOrWhiteSpace(Model.PaymentTerms)
        ? "Please make the payment by the due date."
        : Model.PaymentTerms;
}

<div class="row">

    <div class="col-sm-12 col-md-12 col-lg-12 mb-3">
        <label for="txtPaymentNotes" class="txtPaymentNotes mx-1 fw-bold">Notes</label>
        <textarea id="txtPaymentNotes" asp-for="PaymentNotes" rows="2" class="w-100"></textarea>
    </div>

    <div class="col-sm-12 col-md-12 col-lg-12">
        <label for="txtPaymentTerms" class="txtPaymentTerms mx-1 fw-bold">Terms & Conditions</label>
        <textarea id="txtPaymentTerms" asp-for="PaymentTerms" rows="2" class="w-100"></textarea>
    </div>

</div>