@using invyoc.Extensions
@using invyoc.Models.Enums
@model InvoiceViewModel

@{
    var currencyValues = PrimitiveTypeExtensions.ToSelectList<CurrencyType>();
}

<style>
    div.sticky-top {
        box-shadow: 0 0 10px rgba(0, 0, 0, .15);
    }
</style>

<div class="sticky-top py-3 px-1 bg-light rounded">

    <div class="row">

        <div class="d-flex flex-column gap-2">

            <div class="d-flex align-items-center gap-2 justify-content-end text-end" id="divCurrencySection">
                <label for="currency" class="mb-0 form-label fw-bold">Currency:</label>
                <select id="currency"
                        asp-for="Currency"
                        asp-items="Model.Currencies"
                        class="form-control"
                        style="max-width:120px;">
                </select>
            </div>

            <hr class="mt-0">
        </div>

    </div>


    @await Html.PartialAsync("Partials/_InvoiceFooter", Model)

    <div class="row">
        <div class="text-center mx-2" id="divDownloadInvoice">
            <button class="btn btn-primary" id="download" type="submit">
                Download Invoice
            </button>
        </div>
    </div>

</div>