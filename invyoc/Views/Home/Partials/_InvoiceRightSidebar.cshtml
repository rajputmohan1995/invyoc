@using invyoc.Extensions
@using invyoc.Models.Enums
@model InvoiceViewModel


<div class="sticky-top" style="top:15px;">

    <div class="row">

        <div class="col-sm-12">
            <h5 class="text-center mt-3">Summary</h5>
        </div>

        <div class="col-sm-12">

            <div class="table-responsive" id="divInvoiceSummary">
                <table class="table table-bordered mb-0 border-collapsed">

                    <tr>
                        <td width="40%">
                            <span>Sub Total</span>
                        </td>
                        <td>
                            <span id="lblSubTotalValue">0.00</span>
                        </td>
                    </tr>
                    <tr id="trFinalTotalDetails">
                        <td>
                            <strong>Total</strong>
                            <select id="currency" asp-for="Currency" asp-items="Model.Currencies" style="width:80px;"></select>

                        </td>
                        <td>
                            <h5 class="fw-bold" id="lblFinalTotalValue">0.00</h5>
                        </td>
                    </tr>
                </table>
            </div>
        </div>

    </div>

    <br />

    <div class="row">

        <div class="col-sm-12 col-md-6 col-lg-6">
            <div class="d-grid gap-2">
                <button class="btn btn-dark btn-lg" id="printInvoice" type="submit">
                    <i class="fa fa-print"></i>
                    Print
                </button>
            </div>
        </div>

        <div class="col-sm-12 col-md-6 col-lg-6">
            <div class="d-grid gap-2">
                <button class="btn btn-dark btn-lg" id="downloadInvoice" type="submit">
                    <i class="fa-solid fa-download"></i>
                    Download
                </button>
            </div>
        </div>

    </div>

</div>