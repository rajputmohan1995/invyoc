@using invyoc.Extensions
@model InvoiceViewModel
@{
    var showShipToContent = !string.IsNullOrWhiteSpace(Model.ShipTo.Name) ||
                    !string.IsNullOrWhiteSpace(Model.ShipTo.Address) ||
                    !string.IsNullOrWhiteSpace(Model.ShipTo.ContactNum);

    var invoiceItemIndex = 1;
    var invoiceItemTotal = 0m;
}

<style>

    #pdfFrame header {
        border-bottom: 1px solid #000;
        margin-bottom: 20px;
        padding-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    #pdfFrame h1 {
        margin: 0;
        margin-bottom: 10px;
    }

    #pdfFrame .company-info {
        font-size: 14px;
    }

    #pdfFrame .contact {
        margin-top: 5px;
        font-size: 13px;
    }

    #pdfFrame .invoice-title {
        font-size: 20px;
        text-align: right;
    }

    #pdfFrame .section {
        margin-bottom: 20px;
    }

    #pdfFrame .three-columns {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    #pdfFrame .info-block {
        width: 33%;
        font-size: 14px;
        line-height: 1.6;
    }

    #pdfFrame .invoice-info {
        text-align: right;
    }

    #pdfFrame .section-title {
        font-weight: bold;
        margin-bottom: 5px;
    }

    #pdfFrame table.invoice-items {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 14px;
        clear: both;
        text-align: center;
    }

        #pdfFrame table.invoice-items th,
        #pdfFrame table.invoice-items td {
            border: 1px solid #ccc;
            padding: 5px 8px;
        }

        #pdfFrame table.invoice-items th {
            background-color: #f0f0f0;
        }


    #pdfFrame .footer {
        font-size: 13px;
        font-style: italic;
        clear: both;
        text-align: center;
    }

    #pdfFrame .invoice-info {
        text-align: right;
        min-width: 200px;
    }

    #pdfFrame table.invoiceInfo {
        float: right;
    }

        #pdfFrame table.invoiceInfo tr td strong {
            float: right;
        }

    #pdfFrame .pr-20 {
        padding-right: 20px;
    }

    #pdfFrame table tbody tr td,
    #pdfFrame table tbody tr th {
        line-height: 1.25rem;
    }

    #pdfFrame .border-0 {
        border: 0 !important;
    }

    #pdfFrame .text-left {
        text-align: left;
    }

    #pdfFrame .text-right {
        text-align: right;
    }

    #pdfFrame .m-0 {
        margin: 0;
    }

    #pdfFrame .p-0 {
        padding: 0;
    }

    #pdfFrame img#companyLogo {
        max-width: 150px;
        max-height: 150px;
        margin-bottom: 10px;
    }
</style>


<table width="100%"
       style="border-bottom: 2px solid #000;
                  margin-bottom: 10px;
                  padding-bottom: 10px;
                  font-size: 14px;">
    <tr valign="top">
        <td width="70%">
            <h1>@Model.Company.Name</h1>

            <div style="margin-top: 5px; font-size: 13px">
                <strong style="text-transform: uppercase">@Model.Company.GSTNo</strong><br />
                @Model.Company.Address<br />
                @Model.Company.Phone | <span style="text-transform: lowercase">@Model.Company.Email</span>
            </div>
        </td>
        <td width="30%" style="font-size: 16px; text-align: right">
            @if (!string.IsNullOrWhiteSpace(Model.Company.LogoBase64))
            {
                <img src="@Model.Company.LogoBase64" alt="Logo not found!" id="companyLogo" />                
            }
        </td>
    </tr>
</table>

<table width="100%" style="margin-bottom: 20px; font-size: 14px">
    <tr valign="top">
        <td width="@(showShipToContent ? 35 : 70)%" class="pr-20">
            <strong>Bill To</strong>
            <div style="margin-top:2px;">
                @Model.BillTo.Name<br />
                <span style="word-wrap: break-word">@Model.BillTo.Address</span>
                <br />
                <span style="word-wrap: break-word">@Model.BillTo.ContactNum</span>
            </div>
        </td>


        @if (showShipToContent)
        {
            <td width="35%" class="pr-20">
                <strong>Ship To</strong>
                <div style="margin-top:2px;">
                    @Model.ShipTo.Name<br />
                    <span style="word-wrap: break-word">@Model.ShipTo.Address</span>
                    <br />
                    <span style="word-wrap: break-word">@Model.ShipTo.ContactNum</span>
                </div>
            </td>
        }


        <td width="30%" style="min-width: 200px; text-align: right">
            <table class="invoiceInfo">
                <tr>
                    <td><strong>Invoice#</strong></td>
                    <td>:</td>
                    <td><span style="font-weight:bold; font-size:1.25rem;">@Model.InvoiceNumber</span></td>
                </tr>
                <tr>
                    <td><strong>Date</strong></td>
                    <td>:</td>
                    <td><span>@PrimitiveTypeExtensions.ToDateStr(Model.InvoiceDate)</span></td>
                </tr>
                <tr>
                    <td><strong>Due Date</strong></td>
                    <td>:</td>
                    <td><span>@PrimitiveTypeExtensions.ToDateStr(Model.DueDate)</span></td>
                </tr>
                <tr>
                    <td><strong>Payment Terms</strong></td>
                    <td>:</td>
                    <td><span>@Model.PaymentTerms</span></td>
                </tr>
                <tr>
                    <td><strong>PO Number</strong></td>
                    <td>:</td>
                    <td><span>@Model.PONumber</span></td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<table class="invoice-items">
    <thead>
        <tr>
            <th width="7%">#</th>
            <th class="text-left">Item Description</th>
            <th width="10%">Quantity</th>
            <th width="15%">Rate</th>
            <th width="18%">Amount</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model.Items)
        {
            var itemTotal = (item.Rate * item.Quantity).ToFormat();

            <tr>
                <td>@invoiceItemIndex</td>
                <td class='text-left'>@item.Description</td>
                <td>@item.Quantity</td>
                <td>@item.Rate.ToCurrency()</td>
                <td>@itemTotal.ToCurrency()</td>
            </tr>

            invoiceItemIndex++;
            invoiceItemTotal += itemTotal;
        }


        @{
            var discountAmount = ((invoiceItemTotal * Model.DiscountPercentage) / 100).ToFormat();
            var taxAmount = (((invoiceItemTotal - discountAmount) * Model.TaxPercentage) / 100).ToFormat();
            var finalAmount = (invoiceItemTotal - discountAmount + taxAmount).ToFormat();
        }


        <tr>
            <td class='border-0 p-0 m-2' colspan='5'></td>
        </tr>

        <tr>
            <td class='border-0' colspan='3'></td>
            <td class='text-right'>Subtotal</td>
            <td>@Model.Currency @invoiceItemTotal.ToCurrency()</td>
        </tr>

        <tr>
            <td class='border-0' colspan='3'></td>
            <td class='text-right'>Discount (@(Model.DiscountPercentage)%)</td>
            <td>@Model.Currency @discountAmount.ToCurrency()</td>
        </tr>

        <tr>
            <td class='border-0' colspan='3'></td>
            <td class='text-right'>Tax (@(Model.TaxPercentage)%)</td>
            <td>@Model.Currency @taxAmount.ToCurrency()</td>
        </tr>

        <tr>
            <td class='border-0' colspan='3'></td>
            <td class='text-right'><strong>Total</strong></td>
            <td><strong>@Model.Currency @finalAmount.ToCurrency()</strong></td>
        </tr>

    </tbody>
</table>


<br />
<div class="footer">@Model.PaymentNotes</div>