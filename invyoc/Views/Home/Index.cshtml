@model InvoiceViewModel
@{
    ViewData["Title"] = "Create and Download Invoices Instantly";
    Layout = "_FreeInvoiceLayout";
}

@using (Html.BeginForm("Download", "Home", FormMethod.Post))
{
    <div class="row mx-1 my-2">

        <!-- Left Section (Invoice Editor) -->
        <div class="col-lg-9 invoice-box bg-light" id="invoice">

            @await Html.PartialAsync("Partials/_InvoiceHeader", Model)

            @await Html.PartialAsync("Partials/_InvoiceBody", Model)

            @await Html.PartialAsync("Partials/_InvoiceItems", Model)

            @* @await Html.PartialAsync("Partials/_InvoiceFooter", Model) *@

        </div>

        <!-- Right Side Static Panel -->
        <div class="col-lg-3">
            @await Html.PartialAsync("Partials/_InvoiceRightSidebar", Model)
        </div>

    </div>
}

@section Scripts {
    <script src="~/js/free-invoice/index.js"></script>
}