@using System.Text.Json
@using invyoc.Extensions
@model List<SavedInvoiceData>
@{
    ViewData["Title"] = "Saved Invoices";
}

<main class="my-2">

    <h2 class="text-center text-decoration-underline">
        Invoices for @Convert.ToString(ViewBag.SavedInfoMonthYear)
    </h2>


    @if (Model != null && Model.Any())
    {
        <table class="table table-sm table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Id</th>
                    <th>Invoice From</th>
                    <th>Bill To & Ship To</th>
                    <th width="20%">Item Count & Totals</th>
                    <th width="10%">Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var invoiceVM = item.InvoiceVM;
                    var itemCount = invoiceVM?.Items?.Count ?? 0;
                    var subTotal = invoiceVM?.Subtotal ?? 0;

                    var sgstTotal = invoiceVM?.Items?.Sum(x => (x.SGST * x.Amount) / 100) ?? 0;
                    var cgstTotal = invoiceVM?.Items?.Sum(x => (x.CGST * x.Amount) / 100) ?? 0;
                    var cessTotal = invoiceVM?.Items?.Sum(x => (x.Cess * x.Amount) / 100) ?? 0;

                    var total = subTotal + sgstTotal + cgstTotal + cessTotal;


                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", "Invoice", new { id = @item.Id, p = CommonSetting.PassKey })'">
                        <td>@item.Id</td>
                        <td>
                            <img width="100" height="100" src="@invoiceVM.Company.LogoBase64" alt="no image!" />
                            <br />
                            @(invoiceVM?.Company?.Name ?? "[Invoice From Name]")
                            <br />
                            @(invoiceVM?.Company?.GSTNo ?? "[Invoice From GST]")
                            <br />
                            @(invoiceVM?.Company?.CompanyAddress?.Address ?? "[Invoice From Address]")
                        </td>
                        <td>
                            @(invoiceVM?.BillTo?.Name ?? "[Bill To Name]")
                            <br />
                            @(invoiceVM?.BillTo?.GSTNo ?? "[Bill To GST]")
                            <br />
                            @(invoiceVM?.BillTo?.ClientAddress?.Address ?? "[Bill To Address]")
                            <br />

                            <strong>[Ship To]</strong>
                            @(invoiceVM?.ShipTo?.Name ?? "[Ship To Name]")
                            <br />
                            @(invoiceVM?.ShipTo?.GSTNo ?? "[Ship To GST]")
                            <br />
                            @(invoiceVM?.ShipTo?.ClientAddress?.Address ?? "[Ship To Address]")
                        </td>

                        <td>
                            Items Count : @itemCount <br />
                            SubTotal : @PrimitiveTypeExtensions.ToCurrency(subTotal)<br />
                            SGST : @PrimitiveTypeExtensions.ToCurrency(sgstTotal)<br />
                            CGST : @PrimitiveTypeExtensions.ToCurrency(cgstTotal)<br />
                            Cess : @PrimitiveTypeExtensions.ToCurrency(cessTotal)<br />
                            Total : <strong> @invoiceVM?.Currency@PrimitiveTypeExtensions.ToCurrency(total)</strong><br />
                        </td>

                        <td>@item.Timestamp.ToLocalTime().ToString("dd-MMM-yyyy hh:mm:ss tt")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No data available.</div>
    }


</main>