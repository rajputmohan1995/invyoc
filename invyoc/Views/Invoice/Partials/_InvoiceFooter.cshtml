@model InvoiceViewModel

<div class="row">

    <div class="col-sm-12 col-md-4 col-lg-4 mb-3">
        <div class="card">
            <div class="card-header text-center">
                <h5 class="m-0">
                    <strong>Notes</strong>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="floating-label mb-0">
                    <textarea id="txtPaymentNotes" asp-for="PaymentNotes" rows="3" class="w-100 border-0" data-save></textarea>
                    <label for="txtPaymentNotes" class="txtPaymentNotes mx-1 fw-bold"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12 col-md-8 col-lg-8">
        <div class="card">
            <div class="card-header text-center">
                <h5 class="m-0">
                    <strong>Terms & Conditions</strong>
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="floating-label mb-0">
                    <textarea id="txtPaymentTerms" asp-for="PaymentTerms" rows="3" class="w-100 border-0" data-save></textarea>
                    <label for="txtPaymentTerms" class="txtPaymentTerms mx-1 fw-bold"></label>
                </div>
            </div>
        </div>
    </div>
</div>
