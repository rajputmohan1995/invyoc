@model InvoiceViewModel

<div class="row">

    <div class="col-sm-12 col-md-6 col-lg-6 mb-3">
        <div class="floating-label">
            <textarea id="txtPaymentNotes" asp-for="PaymentNotes" rows="3" class="w-100" data-save></textarea>
            <label for="txtPaymentNotes" class="txtPaymentNotes mx-1 fw-bold">Notes</label>
        </div>
    </div>

    <div class="col-sm-12 col-md-6 col-lg-6">
        <div class="floating-label">
            <textarea id="txtPaymentTerms" asp-for="PaymentTerms" rows="3" class="w-100" data-save></textarea>
            <label for="txtPaymentTerms" class="txtPaymentTerms mx-1 fw-bold">Terms & Conditions</label>
        </div>
    </div>

</div>