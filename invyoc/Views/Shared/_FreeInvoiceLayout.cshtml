<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    @* <meta name="viewport" content="width=device-width, initial-scale=1.0"> *@
    <meta name="viewport" content="width=1024" />

    <!-- Primary Meta Tags -->
    <title>@ViewData["Title"] - Free Invoices</title>

    @await Html.PartialAsync("_MetaTags")

    <!-- Favicon -->
    <link rel="icon" href="/default-icon.png" type="image/x-icon" />

    <!-- Canonical -->
    <link rel="canonical" href="https://freeinvoice.runasp.net/" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />


    @RenderSection("Styles", false)

    <link href="~/css/site.css" rel="stylesheet" />

    @await Html.PartialAsync("_GoogleScripts")

</head>
<body>

    <div class="container-fluid">

        <nav class="navbar navbar-expand-lg navbar-light row pt-0">
            <div class="container pt-0 pb-0 border-bottom">

                <a class="navbar-brand ms-4 me-2" asp-controller="Home" asp-action="Index">
                    <img class="img-icon" src="~/default-icon.png" loading="lazy" alt="site-icon" />
                </a>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav float-end navbar-link">

                        <li class="nav-item">
                            <h1 class="fs-5 m-0">
                                <a class="nav-link active" asp-controller="Home" asp-action="Index">
                                    Free Invoices - Create and Download Invoices Instantly
                                </a>
                            </h1>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        @RenderBody()

        <footer class="text-center my-3">
            <div class="footer-container">
                <p class="m-1">&copy; <span id="spanCurrentYear"></span> Free Invoices. All rights reserved.</p>
                <nav>
                    <a asp-controller="Home" asp-action="About">About</a> |
                    <a asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a> |
                    <a asp-controller="Home" asp-action="Terms">Terms</a>
                </nav>
            </div>
        </footer>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.min.js"></script>

    @RenderSection("Scripts", false)


    <script src="~/js/scripts.js" type="text/javascript"></script>

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebSite",
            "name": "Free Invoices",
            "url": "https://freeinvoice.runasp.net/",
            "description": "Generate invoices quickly and for free. Customize, download, and send invoices instantly.",
            "applicationCategory": "BusinessApplication",
            "operatingSystem": "All",
            "offers": {
                "@@type": "Offer",
                "price": "0",
                "priceCurrency": "INR"
            },
            "publisher": {
              "@@type": "Organization",
              "name": "FreeInvoices"
            }
        }
    </script>

</body>
</html>
