<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary Meta Tags -->
    <title>Free GST Bills - @ViewData["Title"]</title>

    @await Html.PartialAsync("_MetaTags")

    <!-- Favicon -->
    <link rel="icon" href="/default-icon.png" type="image/x-icon" />

    <!-- Canonical -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=TikTok+Sans:opsz,wght@12..36,300..900&display=swap"
          rel="stylesheet" />


    @RenderSection("Styles", false)

    <link href="~/css/site.css" rel="stylesheet" />

    @await Html.PartialAsync("_GoogleScripts")

</head>

<body>


    @await Html.PartialAsync("_Navbar")

    @RenderBody()

    <footer class="text-center mb-3 mt-5">
        <div class="footer-container">
            <p class="m-1">&copy; <span id="spanCurrentYear"></span> Free GST Bill. All rights reserved.</p>
            <nav>
                <a asp-controller="Home" asp-action="About">About</a> |
                <a asp-controller="Home" asp-action="PrivacyPolicy">Privacy Policy</a> |
                <a asp-controller="Home" asp-action="Terms">Terms</a>
            </nav>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", false)


    <script src="~/js/scripts.js" type="text/javascript"></script>

    @await Html.PartialAsync("_ExtraScripts")
    @await Html.PartialAsync("_ValidationScriptsPartial")

</body>

</html>